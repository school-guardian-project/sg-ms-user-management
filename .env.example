# Copiar a .env y completar. El .env no se versiona.
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=school-guardian;User Id={user};Password={password};TrustServerCertificate=True

Kafka__BootstrapServers=kafka:9092

# gRPC de ms-school-management (validacion de colegio y sede al dar de alta).
SchoolManagement__GrpcAddress={school-management-grpc-address}

# Firma del JWT que emite ms-iam (debe ser el mismo secreto).
Jwt__Secret={jwt-secret}

# HTTP/1.1 para Kong (controladores REST).
ASPNETCORE_Kestrel__Endpoints__Http__Url=http://0.0.0.0:8080
ASPNETCORE_Kestrel__Endpoints__Http__Protocols=Http1

# h2c (HTTP/2 sin TLS), exclusivo para el gRPC interno entre servicios.
ASPNETCORE_Kestrel__Endpoints__Grpc__Url=http://0.0.0.0:5001
ASPNETCORE_Kestrel__Endpoints__Grpc__Protocols=Http2
